        <mxCell id="c22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" value="&lt;b&gt;br-ex (OVS)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;외부망 브리지 — qg 들이 여기 붙음&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="40" y="740" as="geometry" />
        </mxCell>
        <mxCell id="c23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;arcSize=10;" value="&lt;b&gt;veth 호스트측 (예: veth-ex)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;203.0.113.1/24 — 가짜 외부망의 게이트웨이&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="340" y="740" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" value="&lt;b&gt;host iptables MASQUERADE&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;203.0.113.0/24 → ens3 → 가비아 → 인터넷&lt;/font&gt;" vertex="1">
          <mxGeometry height="50" width="260" x="640" y="740" as="geometry" />
        </mxCell>
