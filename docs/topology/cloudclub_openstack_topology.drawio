        <mxCell id="c2" value="프로젝트 study-⟨이름⟩ 하나에 네트워크 1개, 라우터 1개, VM 3대. 슬롯 cc01~cc05·test 모두 같은 모양입니다." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;인터넷&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;가비아 NAT 밖&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3d7ab8;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="110" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;외부 네트워크 203.0.113.0/24&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;FIP 풀 · net01 br-ex&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3d7ab8;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="200" width="240" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;⟨이름⟩-router&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;GW 203.0.113.x  |  내부 10.⟨N⟩.0.1&lt;br&gt;SNAT + FIP DNAT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="300" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;⟨이름⟩-net  10.⟨N⟩.0.0/24&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;DHCP .2 (qdhcp) · MTU 1450&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="420" width="760" height="44" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c3" target="c4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c4" target="c5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c5" target="c6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;b&gt;vm1  (10.⟨N⟩.0.v)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;cmp01에서 실행 · CirrOS&lt;br&gt;FIP 있음 → ssh cirros@FIP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="300" y="540" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.158;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c10">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;b&gt;vm2  (10.⟨N⟩.0.v)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;cmp02에서 실행 · CirrOS&lt;br&gt;FIP 있음 → ssh cirros@FIP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="540" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c12">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;b&gt;vm3  (10.⟨N⟩.0.v)&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;cmp01에서 실행 · CirrOS&lt;br&gt;FIP 없음 → vm1에서 ssh로 건너감&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="540" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.842;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c6" target="c14">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;b&gt;⟨이름⟩-sg&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;ICMP · TCP 22 만 허용&lt;br&gt;(VM이 있는 컴퓨트 노드의 qbr에서 iptables로 적용)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="1100" y="540" width="240" height="70" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;핵심 포인트&lt;/b&gt;&lt;br&gt;• VM 3대는 같은 네트워크에 있지만 &lt;b&gt;물리적으로는 다른 노드(cmp01/cmp02)&lt;/b&gt;에 있을 수 있다 → 노드 사이는 VXLAN 터널&lt;br&gt;• 밖에서 VM으로 들어오려면 &lt;b&gt;FIP&lt;/b&gt;가 필요하고, FIP는 라우터(qrouter)가 DNAT로 바꿔준다&lt;br&gt;• VM이 밖으로 나갈 때는 FIP가 없어도 라우터의 SNAT로 나간다 (vm3도 인터넷은 됨)&lt;br&gt;• 계정: cirros / gocubsgo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="660" width="1040" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3. 패킷의 여행 (브리지·tap)" id="3._패킷의_여행_(브리지·tap)">
    <mxGraphModel dx="1896" dy="1076" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
