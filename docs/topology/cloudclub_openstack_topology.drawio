        <mxCell id="c24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3d7ab8;fontSize=12;arcSize=10;" value="&lt;b&gt;가짜 외부망 203.0.113.0/24 → 인터넷&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px;font-weight:normal&#39;&gt;net01 안에서 만든 외부망. FIP도 이 대역. 가비아 밖에서는 안 보임&lt;/font&gt;" vertex="1">
          <mxGeometry height="56" width="300" x="380" y="660" as="geometry" />
        </mxCell>
