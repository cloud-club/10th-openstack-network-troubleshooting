          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c60" edge="1" parent="1" source="c42" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c45" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c61" edge="1" parent="1" source="c45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c48" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c62" edge="1" parent="1" source="c48" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c51" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c63" edge="1" parent="1" source="c51" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" target="c54" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c64" edge="1" parent="1" source="c22" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1f5fbf;dashed=1;dashPattern=8 4;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" target="c33" value="">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1236" y="370" />
              <mxPoint x="115" y="370" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;거꾸로, 밖에서 들어올 때 — ssh cirros@FIP (ops01에서)&lt;/b&gt;&lt;br&gt;ops01 → (경로: 203.0.113.0/24 는 net01 로) → ⑮ ens3 → ⑬ veth → ⑫ br-ex → ⑪ qrouter: qg 가 FIP 의 ARP 에 답하고 &lt;b&gt;DNAT FIP → 10.N.0.v&lt;/b&gt; → ⑩ ⑨ ⑧ → 터널 → ⑦ … ① vm1&lt;br&gt;NAT 는 DNAT 한 번뿐이고, 답장 패킷은 이미 맺어진 연결이라 MASQUERADE 를 다시 타지 않는다." vertex="1">
          <mxGeometry height="90" width="1000" x="40" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;같은 네트워크의 vm1 ↔ vm2 (노드가 다를 때)&lt;/b&gt;&lt;br&gt;vm1 → ① ~ ⑦ → VXLAN → cmp02 의 ens3 → br-tun → br-int → qvo → qvb → qbr → tap → vm2&lt;br&gt;라우터를 거치지 않는다 (L2). net01 도 안 거친다." vertex="1">
          <mxGeometry height="90" width="610" x="1070" y="620" as="geometry" />
        </mxCell>
        <mxCell id="c67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;왜 이렇게 많은가?&lt;/b&gt;&lt;br&gt;• tap: libvirt 가 VM 에 꽂아주는 NIC&lt;br&gt;• qbr: OVS 는 iptables 를 못 쓰므로 시큐리티 그룹용 Linux 브리지를 하나 끼움 (iptables_hybrid)&lt;br&gt;• qvb/qvo: Linux 브리지와 OVS 브리지는 직접 못 붙어서 veth 로 연결&lt;br&gt;• br-int / br-tun: 분리(VLAN tag)와 노드 간 전송(VXLAN)을 나눠 맡음" vertex="1">
          <mxGeometry height="100" width="1000" x="40" y="730" as="geometry" />
        </mxCell>
        <mxCell id="c68" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;이름 읽는 법&lt;/b&gt;&lt;br&gt;XXXXXXXX-XX 는 Neutron 포트 ID 앞 11자.&lt;br&gt;같은 VM 의 tap · qbr · qvb · qvo 는 모두 같은 접미사라서&lt;br&gt;&lt;code&gt;openstack port list&lt;/code&gt; 로 ID 를 보면 한 번에 찾을 수 있다." vertex="1">
          <mxGeometry height="100" width="610" x="1070" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
