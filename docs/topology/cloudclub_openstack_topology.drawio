        <mxCell id="c27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;읽는 순서&lt;/b&gt;&lt;br&gt;① 이 페이지: 노드가 뭐가 있고 무슨 역할인지&lt;br&gt;② 참가자 1명 리소스: 내가 받은 VM 3대가 어떻게 생겼는지&lt;br&gt;③ 패킷의 여행: VM에서 나간 패킷이 거치는 브리지·tap 한 줄&lt;br&gt;④ net01 내부: 라우터·DHCP 네임스페이스" vertex="1">
          <mxGeometry height="110" width="520" x="40" y="740" as="geometry" />
        </mxCell>
        <mxCell id="c28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;자주 쓰는 명령&lt;/b&gt;&lt;br&gt;노드 접속: ssh ⟨노드⟩ (ops01에서)&lt;br&gt;OVS 보기: sudo ovs-vsctl show&lt;br&gt;브리지 보기: ip link / brctl show&lt;br&gt;네임스페이스: ip netns / ip netns exec qrouter-… ip a&lt;br&gt;컨테이너: sudo docker ps" vertex="1">
          <mxGeometry height="110" width="400" x="600" y="740" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2. 참가자 1명 리소스" id="2._참가자_1명_리소스">
