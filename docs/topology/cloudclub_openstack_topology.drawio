          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c27" edge="1" parent="1" source="c23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;" target="c24" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c28" edge="1" parent="1" source="c24" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#ae4132;dashed=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" target="c3" value="ens3 로 송출">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1140" y="765" />
              <mxPoint x="1140" y="132" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="c29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;" value="&lt;b&gt;왜 veth 와 가짜 외부망?&lt;/b&gt; 가비아 VM 은 NIC 가 ens3 하나뿐이라 br-ex 에 붙일 진짜 외부 인터페이스가 없다. 그래서 veth 한 쌍을 만들어 한쪽은 br-ex 에, 다른 쪽은 호스트에 두고 203.0.113.0/24 의 게이트웨이로 삼은 뒤 MASQUERADE 로 내보낸다. FIP 가 이 대역이라 가비아 밖에서는 접속이 안 되고, ops01 이 203.0.113.0/24 경로를 net01 로 두어 ssh cirros@FIP 를 한다." vertex="1">
          <mxGeometry height="60" width="1040" x="40" y="820" as="geometry" />
        </mxCell>
      </root>
