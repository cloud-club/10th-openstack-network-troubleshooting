, 145));"/></g></g><g data-cell-id="c9"><g><path d="M 655 355 L 655 415" fill="none" stroke="#6b6b6b" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(107, 107, 107), rgb(145, 145, 145));"/></g></g><g data-cell-id="c10"><g transform="translate(0.5,0.5)"><rect x="275" y="535" width="240" height="70" rx="7" ry="7" fill="#fff2cc" stroke="#d6b656" pointer-events="all" style="fill: light-dark(rgb(255, 242, 204), rgb(40, 29, 0)); stroke: light-dark(rgb(214, 182, 86), rgb(109, 81, 0));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 238px; height: 1px; padding-top: 570px; margin-left: 276px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>vm1  (10.⟨N⟩.0.v)</b><br /><span style="font-size:10px;font-weight:normal">cmp01에서 실행 · CirrOS<br />FIP 있음 → ssh cirros@FIP</span></div></div></div></foreignObject><image x="276" y="549" width="238" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c11"><g><path d="M 395.08 459 L 395.09 487 Q 395.1 497 395.07 507 L 395 535" fill="none" stroke="#6b6b6b" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(107, 107, 107), rgb(145, 145, 145));"/></g></g><g data-cell-id="c12"><g transform="translate(0.5,0.5)"><rect x="535" y="535" width="240" height="70" rx="7" ry="7" fill="#fff2cc" stroke="#d6b656" pointer-events="all" style="fill: light-dark(rgb(255, 242, 204), rgb(40, 29, 0)); stroke: light-dark(rgb(214, 182, 86), rgb(109, 81, 0));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 238px; height: 1px; padding-top: 570px; margin-left: 536px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>vm2  (10.⟨N⟩.0.v)</b><br /><span style="font-size:10px;font-weight:normal">cmp02에서 실행 · CirrOS<br />FIP 있음 → ssh cirros@FIP</span></div></div></div></foreignObject><image x="536" y="549" width="238" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c13"><g><path d="M 655 459 L 655 535" fill="none" stroke="#6b6b6b" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(107, 107, 107), rgb(145, 145, 145));"/></g></g><g data-cell-id="c14"><g transform="translate(0.5,0.5)"><rect x="795" y="535" width="240" height="70" rx="7" ry="7" fill="#fff2cc" stroke="#d6b656" pointer-events="all" style="fill: light-dark(rgb(255, 242, 204), rgb(40, 29, 0)); stroke: light-dark(rgb(214, 182, 86), rgb(109, 81, 0));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 238px; height: 1px; padding-top: 570px; margin-left: 796px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>vm3  (10.⟨N⟩.0.v)</b><br /><span style="font-size:10px;font-weight:normal">cmp01에서 실행 · CirrOS<br />FIP 없음 → vm1에서 ssh로 건너감</span></div></div></div></foreignObject><image x="796" y="549" width="238" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c15"><g><path d="M 914.92 459 L 914.91 487 Q 914.9 497 914.93 507 L 915 535" fill="none" stroke="#6b6b6b" stroke-width="2" stroke-miterlimit="10" pointer-events="stroke" style="stroke: light-dark(rgb(107, 107, 107), rgb(145, 145, 145));"/></g></g><g data-cell-id="c16"><g transform="translate(0.5,0.5)"><rect x="1075" y="535" width="240" height="70" rx="7" ry="7" fill="#ffe6cc" stroke="#d79b00" pointer-events="all" style="fill: light-dark(rgb(255, 230, 204), rgb(54, 33, 10)); stroke: light-dark(rgb(215, 155, 0), rgb(153, 101, 0));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 238px; height: 1px; padding-top: 570px; margin-left: 1076px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>⟨이름⟩-sg</b><br /><span style="font-size:10px;font-weight:normal">ICMP · TCP 22 만 허용<br />(VM이 있는 컴퓨트 노드의 qbr에서 iptables로 적용)</span></div></div></div></foreignObject><image x="1076" y="549" width="238" height="46" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c17"><g transform="translate(0.5,0.5)"><rect x="275" y="655" width="1040" height="100" rx="15" ry="15" fill="#fffde7" stroke="#c9b458" pointer-events="all" style="fill: light-dark(rgb(255, 253, 231), rgb(24, 22, 4)); stroke: light-dark(rgb(201, 180, 88), rgb(104, 86, 7));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-start; justify-content: unsafe flex-start; width: 1030px; height: 1px; padding-top: 666px; margin-left: 285px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #000000; "><div style="display: inline-block; font-size: 11px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>핵심 포인트</b><br />• VM 3대는 같은 네트워크에 있지만 <b>물리적으로는 다른 노드(cmp01/cmp02)</b>에 있을 수 있다 → 노드 사이는 VXLAN 터널<br />• 밖에서 VM으로 들어오려면 <b>FIP</b>가 필요하고, FIP는 라우터(qrouter)가 DNAT로 바꿔준다<br />• VM이 밖으로 나갈 때는 FIP가 없어도 라우터의 SNAT로 나간다 (vm3도 인터넷은 됨)<br />• 계정: cirros / gocubsgo</div></div></div></foreignObject><image x="285" y="666.5" width="1030" height="68.75" xlink:href="data:image/png;base64,"/></switch></g></g></g></g></g></g></svg>