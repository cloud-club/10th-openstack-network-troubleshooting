gt;인터넷&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;가비아 NAT 밖&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;50&quot; width=&quot;240&quot; x=&quot;560&quot; y=&quot;110&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c4&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e6f2ff;strokeColor=#3d7ab8;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;외부 네트워크 203.0.113.0/24&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;FIP 풀 · net01 br-ex&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;50&quot; width=&quot;240&quot; x=&quot;560&quot; y=&quot;200&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c5&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;arcSize=10;dashed=1;&quot; value=&quot;&amp;lt;b&amp;gt;⟨이름⟩-router&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;GW 203.0.113.x  |  내부 10.⟨N⟩.0.1&amp;lt;br&amp;gt;SNAT + FIP DNAT&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;60&quot; width=&quot;240&quot; x=&quot;560&quot; y=&quot;300&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c6&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;⟨이름⟩-net  10.⟨N⟩.0.0/24&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;DHCP .2 (qdhcp) · MTU 1450&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;44&quot; width=&quot;760&quot; x=&quot;300&quot; y=&quot;420&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c7&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c3&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;&quot; target=&quot;c4&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c8&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c4&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;&quot; target=&quot;c5&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c9&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c5&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;&quot; target=&quot;c6&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c10&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;vm1  (10.⟨N⟩.0.v)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;cmp01에서 실행 · CirrOS&amp;lt;br&amp;gt;FIP 있음 → ssh cirros@FIP&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;70&quot; width=&quot;240&quot; x=&quot;300&quot; y=&quot;540&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c11&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c6&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.158;exitY=1;entryX=0.5;entryY=0;&quot; target=&quot;c10&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c12&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;vm2  (10.⟨N⟩.0.v)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;cmp02에서 실행 · CirrOS&amp;lt;br&amp;gt;FIP 있음 → ssh cirros@FIP&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;70&quot; width=&quot;240&quot; x=&quot;560&quot; y=&quot;540&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c13&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c6&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.500;exitY=1;entryX=0.5;entryY=0;&quot; target=&quot;c12&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c14&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;vm3  (10.⟨N⟩.0.v)&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;cmp01에서 실행 · CirrOS&amp;lt;br&amp;gt;FIP 없음 → vm1에서 ssh로 건너감&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;70&quot; width=&quot;240&quot; x=&quot;820&quot; y=&quot;540&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c15&quot; edge=&quot;1&quot; parent=&quot;1&quot; source=&quot;c6&quot; style=&quot;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=#6b6b6b;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.842;exitY=1;entryX=0.5;entryY=0;&quot; target=&quot;c14&quot; value=&quot;&quot;&gt;&#10;          &lt;mxGeometry relative=&quot;1&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c16&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;arcSize=10;&quot; value=&quot;&amp;lt;b&amp;gt;⟨이름⟩-sg&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;&amp;lt;font style=&amp;#39;font-size:10px;font-weight:normal&amp;#39;&amp;gt;ICMP · TCP 22 만 허용&amp;lt;br&amp;gt;(VM이 있는 컴퓨트 노드의 qbr에서 iptables로 적용)&amp;lt;/font&amp;gt;&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;70&quot; width=&quot;240&quot; x=&quot;1100&quot; y=&quot;540&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;        &lt;mxCell id=&quot;c17&quot; parent=&quot;1&quot; style=&quot;rounded=1;whiteSpace=wrap;html=1;fillColor=#fffde7;strokeColor=#c9b458;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;&quot; value=&quot;&amp;lt;b&amp;gt;핵심 포인트&amp;lt;/b&amp;gt;&amp;lt;br&amp;gt;• VM 3대는 같은 네트워크에 있지만 &amp;lt;b&amp;gt;물리적으로는 다른 노드(cmp01/cmp02)&amp;lt;/b&amp;gt;에 있을 수 있다 → 노드 사이는 VXLAN 터널&amp;lt;br&amp;gt;• 밖에서 VM으로 들어오려면 &amp;lt;b&amp;gt;FIP&amp;lt;/b&amp;gt;가 필요하고, FIP는 라우터(qrouter)가 DNAT로 바꿔준다&amp;lt;br&amp;gt;• VM이 밖으로 나갈 때는 FIP가 없어도 라우터의 SNAT로 나간다 (vm3도 인터넷은 됨)&amp;lt;br&amp;gt;• 계정: cirros / gocubsgo&quot; vertex=&quot;1&quot;&gt;&#10;          &lt;mxGeometry height=&quot;100&quot; width=&quot;1040&quot; x=&quot;300&quot; y=&quot;660&quot; as=&quot;geometry&quot; /&gt;&#10;        &lt;/mxCell&gt;&#10;      &lt;/root&gt;&#10;    &lt;/mxGraphModel&gt;&#10;  &lt;/diagram&gt;&#10;&lt;/mxfile&gt;&#10;"><style type="text/css">@supports (color: light-dark(#000, #fff)) { #ge-svg-qjl3NqrFPJBf5veoI8Fo { --ge-adaptive-bg: light-dark(#ffffff, var(--ge-dark-color, #121212)); --ge-adaptive-fg: light-dark(#000000, var(--ge-light-color, #ffffff)); } }</style><defs/><rect fill="#ffffff" width="100%" height="100%" x="0" y="0" style="fill: var(--ge-adaptive-bg, #ffffff);"/><g><g data-cell-id="0"><g data-cell-id="1"><g data-cell-id="c1"><g><rect x="15" y="15" width="900" height="40" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe flex-start; width: 898px; height: 1px; padding-top: 35px; margin-left: 17px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #000000; "><div style="display: inline-block; font-size: 20px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; font-weight: bold; white-space: normal; word-wrap: normal; ">참가자 1명이 받는 리소스 (논리 구성)</div></div></div></foreignObject><image x="17" y="23.5" width="898" height="29" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c2"><g><rect x="15" y="55" width="900" height="24" fill="none" stroke="none" pointer-events="all"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe flex-start; justify-content: unsafe flex-start; width: 898px; height: 1px; padding-top: 62px; margin-left: 17px;"><div style="box-sizing: border-box; font-size: 0; text-align: left; color: #555555; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: light-dark(#555555, #a4a4a4); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; ">프로젝트 study-⟨이름⟩ 하나에 네트워크 1개, 라우터 1개, VM 3대. 슬롯 cc01~cc05·test 모두 같은 모양입니다.</div></div></div></foreignObject><image x="17" y="62.5" width="898" height="17" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c3"><g transform="translate(0.5,0.5)"><rect x="535" y="105" width="240" height="50" rx="5" ry="5" fill="#e6f2ff" stroke="#3d7ab8" pointer-events="all" style="fill: light-dark(rgb(230, 242, 255), rgb(22, 32, 43)); stroke: light-dark(rgb(61, 122, 184), rgb(94, 147, 200));"/></g><g><g><switch><foreignObject style="overflow: visible; text-align: left;" pointer-events="none" width="100%" height="100%" requiredFeatures="http://www.w3.org/TR/SVG11/feature#Extensibility"><div xmlns="http://www.w3.org/1999/xhtml" style="display: flex; align-items: unsafe center; justify-content: unsafe center; width: 238px; height: 1px; padding-top: 130px; margin-left: 536px;"><div style="box-sizing: border-box; font-size: 0; text-align: center; color: #000000; "><div style="display: inline-block; font-size: 12px; font-family: Helvetica; color: var(--ge-adaptive-fg, #000000); line-height: 1.2; pointer-events: all; white-space: normal; word-wrap: normal; "><b>인터넷</b><br /><span style="font-size:10px;font-weight:normal">가비아 NAT 밖</span></div></div></div></foreignObject><image x="536" y="116" width="238" height="32" xlink:href="data:image/png;base64,"/></switch></g></g></g><g data-cell-id="c4"><g transform="translate(0.5,0.5)"><rect x="535" y="195" width="240" height="50" rx="5" ry="5" fi